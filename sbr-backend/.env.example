# ==========================================
# SRI BALAJI RENEWABLES (SBR) BACKEND ENV
# ==========================================

# Server & Database
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/sbr_db
BASE_URL=https://sribalajirenewables.com
UPLOAD_PATH=uploads

# Authentication & Security
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_EXPIRE=30d
POS_SYNC_SECRET=sbr_pos_sms_sync_secret_2026

# ==========================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ==========================================
# Option 1 (Recommended): Place your Firebase service account JSON in:
#   sbr-backend/config/firebase-service-account.json
#
# Option 2: Specify the absolute or relative path to the service account JSON:
# FIREBASE_CONFIG_PATH=/var/www/sbr-backend/config/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/var/www/sbr-backend/config/firebase-service-account.json
#
# Option 3: Minified JSON or Base64 string of the service account:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sbrsms-b9d25",...}
#
# Option 4: Individual Firebase Service Account fields:
# FIREBASE_PROJECT_ID=sbrsms-b9d25
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sbrsms-b9d25.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==========================================
# TRANSACTIONAL EMAIL (Nodemailer / SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Note: Set SMTP_SECURE=true if using port 465 (SMTPS)
SMTP_USER=no-reply@sribalajirenewables.com
SMTP_PASS=your_app_password_or_smtp_password
SMTP_FROM="Sri Balaji Renewables" <no-reply@sribalajirenewables.com>
SMTP_FROM_NAME=Sri Balaji Renewables
SMTP_TLS_REJECT_UNAUTHORIZED=true
